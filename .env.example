PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox                  # sandbox | production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance
# Required for OAuth banks (Chase, BofA, etc.) in production.
# Run `ngrok http 8765`, paste the https URL here, and register it in
# Plaid dashboard → Team Settings → API → Allowed redirect URIs.
# PLAID_REDIRECT_URI=https://xxxx.ngrok-free.app
